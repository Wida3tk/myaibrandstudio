rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Assets live at organizations/{orgId}/... (see docs/03-data-model.md). Membership is
    // enforced via an `orgId` custom claim that a Cloud Function sets when a user joins an org
    // (milestone M1). Until that function is deployed, no token carries the claim, so every
    // request here is denied — safe by default, never partially open.
    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.orgId == orgId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
