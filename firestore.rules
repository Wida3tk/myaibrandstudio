rules_version = '2';

// Any path not explicitly matched below is denied by default — this is Firestore's
// built-in behavior, not something this file has to implement. See docs/03-data-model.md
// for the collection shapes this mirrors.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isMember(orgId) {
      return isSignedIn() && memberDoc(orgId).data != null;
    }

    function role(orgId) {
      return memberDoc(orgId).data.role;
    }

    function isEditorOrOwner(orgId) {
      return isMember(orgId) && (role(orgId) == 'editor' || role(orgId) == 'owner');
    }

    function isOwner(orgId) {
      return isMember(orgId) && role(orgId) == 'owner';
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow update: if isOwner(orgId);
      // Self-serve bootstrap: a signed-in user may create an org naming themselves as owner,
      // with no Cloud Function required. This is what keeps M0/M1 usable on the free Spark plan —
      // Cloud Functions (and therefore Blaze) only become necessary starting with the AI gateway.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(orgId);
        // The matching bootstrap case: a user may create their OWN membership doc as "owner",
        // but only once the org doc above already exists and names them as its owner. The app
        // must create the org doc first and wait for it to commit before creating this one —
        // not as a single atomic batch, since rule evaluation for a batched write can't see a
        // sibling write's not-yet-committed document.
        allow create: if isSignedIn() && uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid;
        allow update, delete: if isOwner(orgId);
      }

      match /brands/{brandId} {
        allow read: if isMember(orgId);
        allow create, update: if isEditorOrOwner(orgId);
        allow delete: if isOwner(orgId);

        match /contentItems/{itemId} {
          allow read: if isMember(orgId);
          allow create, update: if isEditorOrOwner(orgId);
          allow delete: if isOwner(orgId);
        }

        match /campaigns/{campaignId} {
          allow read: if isMember(orgId);
          allow create, update: if isEditorOrOwner(orgId);
          allow delete: if isOwner(orgId);
        }

        match /videoProjects/{videoProjectId} {
          allow read: if isMember(orgId);
          allow create, update: if isEditorOrOwner(orgId);
          allow delete: if isOwner(orgId);
        }

        match /calendarEntries/{entryId} {
          allow read: if isMember(orgId);
          allow write: if isEditorOrOwner(orgId);
        }

        match /assets/{assetId} {
          allow read: if isMember(orgId);
          allow write: if isEditorOrOwner(orgId);
        }

        match /templates/{templateId} {
          allow read: if isMember(orgId);
          allow write: if isEditorOrOwner(orgId);
        }

        match /approvals/{approvalId} {
          allow read: if isMember(orgId);
          allow write: if isEditorOrOwner(orgId);
        }

        match /analyticsSnapshots/{snapshotId} {
          allow read: if isMember(orgId);
          allow write: if false; // written only by Cloud Functions
        }
      }
    }

    // Budget meter data: org members may read their own org's usage, never write it.
    match /usage/{orgId}/{document=**} {
      allow read: if isMember(orgId);
      allow write: if false;
    }

    // Admin-only / system-managed: no client access at all, by design (see architecture plan §7).
    match /providerConfigs/{providerId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }
  }
}
